# OnionOverVPN settings — the single home for every address this project uses.
#
# No address is hardcoded anywhere in the scripts, the Tor config or the nftables
# rulesets: those are templates, and the values below are substituted into them at
# container start. `bin/onionvpn init` creates a real .env by copying this file and
# filling in PUBLIC_IP, so change a default here and it reaches every component.
#
# .env is gitignored. This example file is not, so keep real addresses out of it.

# ---------------------------------------------------------------------------
# Where clients connect
# ---------------------------------------------------------------------------
# The server's public address, written into every generated client config as its
# Endpoint. `init` detects it automatically; set it by hand for a DNS name, or
# when the host is behind NAT and clients must reach a router instead.
# (203.0.113.0/24 is the RFC 5737 documentation range — a placeholder, not a real host.)
PUBLIC_IP=203.0.113.10

# Published UDP port for the WireGuard handshake. The only port that has to be
# reachable from the internet. 51820 is the WireGuard default; moving it to 443
# or 53 sometimes gets through restrictive networks.
WG_PORT=51820

# ---------------------------------------------------------------------------
# Inside the tunnel
# ---------------------------------------------------------------------------
# The server's address on the tunnel. Every Tor listener binds to it, clients use
# it as their DNS server, and clients are numbered upward from .2 in the same
# subnet. Change it only if this range collides with a network you already use.
WG_SERVER_IP=10.66.66.1
WG_PREFIX=24

# 1420 = 1500 - 80 bytes of WireGuard overhead. Lower to 1380 if this tunnel runs
# inside another tunnel, or if large transfers stall while small ones work (the
# classic MTU symptom).
WG_MTU=1420

# ---------------------------------------------------------------------------
# Client side
# ---------------------------------------------------------------------------
# Host-side loopback port for the SOCKS5 proxy into Tor.
SOCKS_PORT=1080

# Subnet for the Docker bridge the two containers share. Pinned rather than left
# to Docker, so it cannot collide with networks the host already has — check
# yours with `docker network ls` and `docker network inspect` before changing it.
# This is container-to-container plumbing and never appears inside the tunnel.
DOCKER_NET_SUBNET=172.31.66.0/24

# Docker's embedded DNS resolver. Fixed by Docker, not by us, and listed here only
# so no script has to name it: it resolves on the HOST, which is the one leak this
# project exists to prevent, so the client blocks it outright.
DOCKER_EMBEDDED_DNS=127.0.0.11

# ---------------------------------------------------------------------------
# Verification (`onionvpn test`)
# ---------------------------------------------------------------------------
# Address pinged to prove non-TCP traffic cannot escape. Tor cannot carry ICMP, so
# a reply here would mean the policy is leaking. Must be a host that normally
# answers ping, or the check passes for the wrong reason.
LEAK_PROBE_ADDR=1.1.1.1

# Reports whether the request arrived from a Tor exit relay.
TOR_CHECK_URL=https://check.torproject.org/api/ip

# Any reachable onion service, to prove .onion resolution works.
ONION_CHECK_URL=http://duckduckgogg42xjoc72x3sjasowoarfbgcmvfimaftt6twagswzczad.onion/
